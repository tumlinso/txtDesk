# Python environments, caches, and build output
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
/build/
/dist/

# Todo-orchestrator live database and locks. Durable JSON projections are tracked.
/.todo-orchestrator/state.sqlite3
/.todo-orchestrator/*.sqlite3-shm
/.todo-orchestrator/*.sqlite3-wal
/.todo-orchestrator/*.lock
